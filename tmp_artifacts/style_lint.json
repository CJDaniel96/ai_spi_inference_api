  "input": "/Users/daniel/Projects/ai_spi_inference_api/output/docx/AI_SPI_Inference_API_\u865b\u64ec\u74b0\u5883\u8207\u96e2\u7ddaAIPC\u90e8\u7f72\u624b\u518a.docx",
  "fonts_by_char_count": {
    "Heiti TC": 13696,
