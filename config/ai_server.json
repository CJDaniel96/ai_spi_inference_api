{
  "identity": {
    "site": "SX",
    "factory": "SX",
    "line": "SPI",
    "station_id": "SPI"
  },
  "paths": {
    "watch_root": "D:/spi_ai/output/01/sfcTemp",
    "external_output_root": "D:/Dre/JQ_SPI_02_AI_API/data",
    "backup_output_root": "D:/Dre/JQ_SPI_02_AI_API/backup",
    "state_root": "D:/Dre/JQ_SPI_02_AI_API/controller_state",
    "history_root": "D:/Dre/JQ_SPI_02_AI_API/history"
  },
  "processing": {
    "folder_images_num_threshold": 60,
    "image_extensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".bmp",
      ".tiff",
      ".tif"
    ],
    "image_name_template": "{csv_stem}_{component_name}_{Array_id}_{Pad_id}.jpg",
    "source_settle_seconds": 2.0
  },
  "reliability": {
    "end_to_end_timeout_seconds": 6.0,
    "primary_publish_reserve_seconds": 1.0
  },
  "runtime": {
    "scan_interval_seconds": 0.25,
    "poll_interval_seconds": 0.01,
    "max_active_jobs": 4,
    "discovery_timeout_seconds": 2.0,
    "background_timeout_seconds": 30.0,
    "background_retry_seconds": 5.0
  },
  "inference": {
    "obb": {
      "model_path": "models/appearance/best.pt",
      "device": "cuda:0",
      "imgsz": 640,
      "batch_size": 8,
      "engine_fixed_batch": true,
      "conf": 0.25,
      "iou": 0.7,
      "max_det": 100,
      "startup_timeout_seconds": 120,
      "class_thresholds": {
        "Solder_Paste": 0.7,
        "Stain": 0.25,
        "Missing": 0.25,
        "Insufficient": 0.25,
        "Slump": 0.25,
        "Foreign_object": 0.25,
        "Bridge": 0.25
      }
    }
  },
  "output": {
    "preserve_job_folder": false
  },
  "database": {
    "enabled": true,
    "path": "D:/Dre/JQ_SPI_02_AI_API/records/audit.sqlite3",
    "poll_seconds": 5.0,
    "busy_timeout_seconds": 0.1
  },
  "minifi": {
    "enabled": true,
    "output_path": "D:/Project/AMR/Result/TEMP/spi",
    "poll_seconds": 30.0
  },
  "logging": {
    "log_dir": "log",
    "system_log_file": "system.log"
  }
